# Supabase Project Settings > Data API > Project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase Settings > API Keys > Secret key (sb_secret_...), or legacy service_role
# Server only. Never put this key in public/ or GitHub.
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
# For local play WITHOUT Supabase only: remove the two values above and set this.
# LOCAL_DEMO=1
